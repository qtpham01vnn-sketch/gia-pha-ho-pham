  "familyInfo": {
    "familyName": "Phạm",
    "lineage": "paternal",
    "originPlace": "Làng Cổ Đông Ngạc (Kẻ Vẽ), Bắc Từ Liêm, Hà Nội",
    "motto": "Uống nước nhớ nguồn — Gia đạo trường tồn — Nhân đức vi tiên",
    "hoTruong": "P001",
    "history": "Dòng họ Phạm tại làng Đông Ngạc có nguồn gốc từ vùng đất địa linh nhân kiệt xứ Kinh Bắc, thiên di về định cư và lập nghiệp từ đầu thế kỷ 20. Trải qua 4 thế hệ, con cháu họ Phạm luôn gìn giữ truyền thống hiếu học, cần cù, nhân hậu và phụng sự tổ quốc.",
    "ancestorTemple": {
      "name": "Từ Đường Họ Phạm",
      "address": "Số 18, Ngõ Cổ, Làng Đông Ngạc, Bắc Từ Liêm, Hà Nội",
      "establishedYear": 1950,
      "annualCeremony": "Ngày 15 tháng Giêng (Rằm tháng Giêng) và Lễ tế họ ngày 15 tháng 8 Âm lịch"
    },
    "familyRules": [
      "1. Kính dưỡng ông bà, cha mẹ; phụng thờ tổ tiên chu đáo, giữ trọn chữ Hiếu.",
      "2. Anh em, vợ chồng, con cháu hòa thuận, nhường nhịn, đùm bọc lẫn nhau.",
      "3. Chăm lo học hành, lập thân lập nghiệp bằng con đường chính trực.",
      "4. Giữ gìn gia phong, sống nghĩa tình, tương trợ bà con lối xóm.",
      "5. Hằng năm cùng hướng về cội nguồn trong ngày Giỗ Tổ và các dịp tế lễ."
    ]
  },
